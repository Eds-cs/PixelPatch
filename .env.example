# ─────────────────────────────────────────────────────────────
#  PixelPatch — Expo app environment
# ─────────────────────────────────────────────────────────────
#  Only variables prefixed EXPO_PUBLIC_ are visible to app code.
#
#  ⚠  EXPO_PUBLIC_* values are COMPILED INTO THE APP BUNDLE and can be
#     extracted from any shipped build. They are public. Never put a
#     database password, API secret or private key here — those belong in
#     server/.env, which never leaves the server.
#
#  Load order (later wins):  .env  →  .env.local
#  Restart the dev server after editing; Expo reads these at startup.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API in server/ — no trailing slash, no /api suffix
# (lib/api.js appends /api itself). Falls back to localhost:5000 when unset.
EXPO_PUBLIC_API_URL=http://72.62.248.151

# ── Google Sign-In (optional) ────────────────────────────────
# Leave blank to hide the "Continue with Google" button entirely.
# Google issues one OAuth client ID per platform. Every ID set here must also
# appear in server/.env → GOOGLE_CLIENT_IDS, or the server rejects the token.
# Create them at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
