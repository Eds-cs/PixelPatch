# deploy/.env.example — copy to deploy/.env on the server and fill in.
# deploy/.env holds real secrets: it is gitignored, never commit or share it.

# ── Website address ──────────────────────────────────────────
# The server's DNS name, without https:// — for Azure, the VM's DNS name,
# e.g. pixelpatch.southeastasia.cloudapp.azure.com
SITE_ADDRESS=

# ── Database (created automatically on first start) ──────────
DB_NAME=pixelpatchdb
DB_USER=pixelpatch
# Long random passwords. Generate one with:
#   openssl rand -hex 24
DB_PASS=
DB_ROOT_PASS=

# ── Backend secrets (same names as server/.env.example) ──────
# New values for the live site; don't reuse the ones from your laptop.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
OPENAI_API_KEY=
EMAIL_USER=
EMAIL_PASS=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# https://<SITE_ADDRESS>/payment-success and /payment-failed
XENDIT_SUCCESS_URL=
XENDIT_FAILURE_URL=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# ── Website build options (public; compiled into the website) ─
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
