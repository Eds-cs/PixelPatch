# ─────────────────────────────────────────────────────────────
#  PixelPatch — Express API environment  (server/)
# ─────────────────────────────────────────────────────────────
#  These are REAL SECRETS. This file is gitignored and must never be
#  committed, pasted into chat, or copied into the app's .env — anything in
#  the app's .env ships inside the client bundle.
#
#  Load order (later wins):  .env  →  .env.local
#  Restart the server after editing.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── MySQL  (config/db.js) ────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# ── Auth  (controllers/authController.js, middleware/authMiddleware.js) ──
# Long random string used to sign JWTs. Tokens expire after 7 days.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Google Sign-In  (controllers/authController.js) ──────────
# GOOGLE_CLIENT_ID   : single client ID (legacy / web-only setups).
# GOOGLE_CLIENT_IDS  : comma-separated allow-list — REQUIRED for mobile sign-in,
#                      because Google issues a different client ID per platform
#                      and the token's `aud` claim is whichever one requested it.
#                      Must include every EXPO_PUBLIC_GOOGLE_*_CLIENT_ID.
# Falls back to GOOGLE_CLIENT_ID when GOOGLE_CLIENT_IDS is unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# ── OpenAI  (controllers/aiController.js) ────────────────────
# Powers the /assistant troubleshooting chat.
OPENAI_API_KEY=

# ── Email  (config/mail.js — nodemailer over Gmail) ──────────
# EMAIL_PASS must be a Google *App Password*, not the account password.
# https://myaccount.google.com/apppasswords  (requires 2FA enabled)
EMAIL_USER=
EMAIL_PASS=

# ── Xendit payments  (controllers/paymentController.js, xenditWebhookController.js) ──
# Secret API key from the Xendit dashboard.
XENDIT_SECRET_KEY=
# Shared token Xendit sends as the webhook callback header; the webhook is
# rejected unless it matches. This is what actually confirms a payment.
XENDIT_WEBHOOK_TOKEN=
# Where Xendit redirects the browser after checkout. Point these at the WEB
# build's URLs — native uses an in-app browser and polls for status instead.
XENDIT_SUCCESS_URL=http://localhost:8081/payment-success
XENDIT_FAILURE_URL=http://localhost:8081/payment-failed
